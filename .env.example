# Copy file ini menjadi .env. JANGAN upload .env ke GitHub.
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Hanya dipakai saat pertama kali bootstrap akun admin. Wajib ganti sendiri.
ADMIN_EMAIL=admin@anjemin.local
ADMIN_USERNAME=pengelola
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_MIN_12_KARAKTER
ADMIN_PHONE=6280000000000
# Google: browser key restricted HTTP referrers; server key restricted Places API
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_SERVER_KEY=
# Opsional: SMS OTP sungguhan via Twilio Verify (keduanya wajib jika produksi)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Kontak operator yang benar sebelum go-live
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=


# SIMULATION (lokal), MIDTRANS_SANDBOX, MIDTRANS_LIVE, DISABLED
# Simulasi tidak menerima uang sungguhan dan dilarang di production.
PAYMENT_MODE=SIMULATION
MIDTRANS_SERVER_KEY=

# Next.js / Supabase: isi nilai proyek di .env.local atau Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase PostgreSQL Transaction pooler URI; server only, never NEXT_PUBLIC.
DATABASE_URL=
# Optional isolated application schema; default anjemin.
ANJEMIN_DB_SCHEMA=anjemin

# Optional XYZ tile provider override; defaults to OpenStreetMap.
MAP_TILE_URL=
