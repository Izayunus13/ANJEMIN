{
  "name": "anjemin-campus-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ANJEMIN full-stack MVP: customer, driver, admin, marketplace, referrals, Google Places",
  "type": "module",
  "scripts": {
    "start": "next start",
    "dev": "next dev --webpack",
    "check": "node --check server/src/index.js && node --check client/app.js && node --check scripts/sync-assets.mjs && tsc --noEmit",
    "test": "node --test server/tests/*.test.js",
    "assets": "node scripts/sync-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "build": "next build --webpack",
    "dev:legacy": "node --watch server/src/index.js",
    "start:legacy": "node server/src/index.js",
    "test:e2e": "playwright test",
    "test:vercel": "npm run build && node scripts/test-vercel.mjs",
    "migrate:postgres": "node scripts/migrate-postgres.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@anjemin/legacy-api": "file:server",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
